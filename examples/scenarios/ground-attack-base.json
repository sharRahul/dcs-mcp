  "director": {
    "name": "IronGate",
    "channels": [
      {
        "id": "control",
        "speaker": "Mission control",
        "callsign": "Overlord",
        "frequencyMHz": 251,
        "style": "nato"
      }
    ],
    "events": [
      {
        "id": "brief",
        "phase": "briefing",
        "channel": "control",
        "when": {
          "atSeconds": 1
        },
        "text": "Iron Gate: three vehicle target groups, then Egress Gate. Ranger-1 is friendly. Public F10 annotations expose these positions to both coalitions.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "depart",
        "phase": "atc_departure",
        "channel": "control",
        "when": {
          "worldEvent": {
            "kind": "takeoff",
            "unit": "Anvil-1"
          }
        },
        "text": "Anvil airborne. Dodge is already providing SEAD against Base SAM. The Shilkas remain a separate threat.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "perimeter",
        "phase": "detection",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "unit_in_zone",
              "unit": "Anvil-1",
              "zone": "Base Perimeter"
            }
          ]
        },
        "text": "Anvil entered the base perimeter. This zone cue starts the hostile scramble timer; it is not radar detection.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "scramble",
        "phase": "reinforcements",
        "channel": "control",
        "when": {
          "afterEvent": "perimeter",
          "delaySeconds": 60
        },
        "text": "Base Scramble is now active. The fighter group is optional; complete the ground targets and egress.",
        "seconds": 25,
        "effects": [
          {
            "kind": "activate_group",
            "group": "Base Scramble"
          },
          {
            "kind": "set_flag",
            "flag": 30,
            "value": 1
          }
        ]
      },
      {
        "id": "command_down",
        "phase": "engagement",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Base Command"
            }
          ]
        },
        "text": "Command vehicle destroyed. Logistics and Armour remain separate required objectives.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "logistics_down",
        "phase": "engagement",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Base Logistics"
            }
          ]
        },
        "text": "All Logistics vehicles destroyed. Check the remaining target groups before egress.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "targets_down",
        "phase": "branch",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Base Command"
            },
            {
              "kind": "group_dead",
              "group": "Base Logistics"
            },
            {
              "kind": "group_dead",
              "group": "Base Armour"
            }
          ]
        },
        "text": "All three required ground target groups are destroyed. Fly Anvil-1 through Egress Gate to complete the mission.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "ranger_lost",
        "phase": "failure",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "flag_is_true",
              "flag": 50
            }
          ]
        },
        "text": "Ranger-1 destroyed. The friendly-protection objective has failed.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "egress",
        "phase": "victory",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Base Command"
            },
            {
              "kind": "group_dead",
              "group": "Base Logistics"
            },
            {
              "kind": "group_dead",
              "group": "Base Armour"
            },
            {
              "kind": "unit_in_zone",
              "unit": "Anvil-1",
              "zone": "Egress Gate"
            }
          ]
        },
        "text": "Required targets destroyed and egress condition observed. Final outcome arbitration still applies.",
        "seconds": 25,
        "effects": []
      }
    ]
  },
  "assumptions": [
    "Fictional modern training scenario; country assignments are game settings, not historical service-date claims.",
    "DCS metres: x north, y east; altitude is MSL unless a condition explicitly says AGL. Positions, routes, terrain clearance and mission balance require DCS checks.",
    "Explicit stores are checked against bundled pydcs station compatibility; AI weapon employment and mission completion are not flight-verified.",
    "Director cues are fictional subtitles. No audio, real radar detection, JTAC service or authenticated procedure is configured.",
    "No external scripts or assets are required. The mission remains open after an outcome so the player can return; automatic recovery is not authored.",
    "Iron Gate is a fictional vehicle-based military compound, not a reconstruction of an actual installation. Command, logistics and armour are independently scored vehicle groups; there are no authored buildings, bunkers or static-object targets.",
    "The Anvil AI group task points at Base Command only; the player must select and attack the other target groups. No automatic retasking, laser service or guaranteed AI target destruction is supplied.",
    "Ranger-1 is a friendly command vehicle, not a FAC/JTAC. Target identification and weapon effects near friendly units require live testing.",
    "Native DCS 2.9.31.29434 probes place all eleven compound/protected ground units on land with sampled slopes under five degrees and at least fifteen metres of modelled-scenery clearance."
  ]
}
