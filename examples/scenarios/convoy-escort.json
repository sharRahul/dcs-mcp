  "director": {
    "name": "RiverRoad",
    "channels": [
      {
        "id": "control",
        "speaker": "Mission control",
        "callsign": "Overlord",
        "frequencyMHz": 251,
        "style": "nato"
      }
    ],
    "events": [
      {
        "id": "brief",
        "phase": "briefing",
        "channel": "control",
        "when": {
          "atSeconds": 1
        },
        "text": "River Road: protect Convoy-2 and clear both enemy groups. No automatic JTAC or laser service is provided.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "depart",
        "phase": "atc_departure",
        "channel": "control",
        "when": {
          "worldEvent": {
            "kind": "takeoff",
            "unit": "Guardian-1"
          }
        },
        "text": "Guardian airborne. Use the F10 map and mission briefing to locate the convoy.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "checkpoint",
        "phase": "reinforcements",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "part_of_group_in_zone",
              "group": "Convoy",
              "zone": "Checkpoint"
            }
          ]
        },
        "text": "Convoy reached Checkpoint; the ambush is now active. This is a zone cue, not sensor detection.",
        "seconds": 25,
        "effects": [
          {
            "kind": "activate_group",
            "group": "Ambush"
          },
          {
            "kind": "set_flag",
            "flag": 30,
            "value": 1
          }
        ]
      },
      {
        "id": "second_wave",
        "phase": "escalation",
        "channel": "control",
        "when": {
          "afterEvent": "checkpoint",
          "delaySeconds": 90
        },
        "text": "Armoured reinforcements are moving toward the convoy.",
        "seconds": 25,
        "effects": [
          {
            "kind": "activate_group",
            "group": "Reinforcements"
          },
          {
            "kind": "set_flag",
            "flag": 31,
            "value": 1
          }
        ]
      },
      {
        "id": "ambush_clear",
        "phase": "engagement",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "flag_is_true",
              "flag": 30
            },
            {
              "kind": "group_dead",
              "group": "Ambush"
            }
          ]
        },
        "text": "First ambush cleared. Continue protecting the convoy; the second group still matters.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "cargo_lost",
        "phase": "failure",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "flag_is_true",
              "flag": 50
            }
          ]
        },
        "text": "The designated cargo truck is lost. Convoy protection failed.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "destination",
        "phase": "branch",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "all_of_group_in_zone",
              "group": "Convoy",
              "zone": "Destination"
            }
          ]
        },
        "text": "Surviving convoy units are inside Destination. Final success also requires both hostile groups destroyed and the reinforcement wave released.",
        "seconds": 25,
        "effects": []
      }
    ]
  },
  "assumptions": [
    "Fictional modern training scenario; country assignments are game settings, not historical service-date claims.",
    "DCS metres: x north, y east; altitude is MSL unless a condition explicitly says AGL. Positions, routes, terrain clearance and mission balance require DCS checks.",
    "Explicit stores are checked against bundled pydcs station compatibility; AI weapon employment and mission completion are not flight-verified.",
    "Director cues are fictional subtitles. No audio, real radar detection, JTAC service or authenticated procedure is configured.",
    "No external scripts or assets are required. The mission remains open after an outcome so the player can return; automatic recovery is not authored.",
    "Convoy waypoints follow a 35-point path queried from the native DCS 2.9.31.29434 Caucasus road graph. Ground waypoint actions remain generic; this does not configure On Road formation.",
    "The group-in-zone condition applies to surviving units; Convoy-2 is separately protected. Other vehicle losses do not by themselves fail the mission.",
    "Moving transport groups use native On Road routing; assault groups use native Rank (line abreast) movement. Road availability, deployment room and AI decisions require native verification; formations are authored rather than automatically selected on enemy contact."
  ]
