        "seconds": 25,
        "effects": []
      },
      {
        "id": "radar_down",
        "phase": "engagement",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "unit_dead",
              "unit": "Corridor SAM-1"
            }
          ]
        },
        "text": "Tracking radar destroyed. Other local air defences and launchers may remain.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "strike_release",
        "phase": "reinforcements",
        "channel": "control",
        "when": {
          "afterEvent": "radar_down",
          "delaySeconds": 20
        },
        "text": "Hammer is released against Logistics.",
        "seconds": 25,
        "effects": [
          {
            "kind": "activate_group",
            "group": "Hammer"
          },
          {
            "kind": "set_flag",
            "flag": 30,
            "value": 1
          }
        ]
      },
      {
        "id": "scramble",
        "phase": "escalation",
        "channel": "control",
        "when": {
          "afterEvent": "strike_release",
          "delaySeconds": 45
        },
        "text": "Hostile scramble activated. The strike is still responsible for Logistics.",
        "seconds": 25,
        "effects": [
          {
            "kind": "activate_group",
            "group": "Scramble"
          }
        ]
      },
      {
        "id": "target_down",
        "phase": "branch",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Logistics"
            }
          ]
        },
        "text": "Logistics vehicles destroyed. Check that the tracking radar objective is also complete.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "objective",
        "phase": "victory",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "unit_dead",
              "unit": "Corridor SAM-1"
            },
            {
              "kind": "group_dead",
              "group": "Logistics"
            }
          ]
        },
        "text": "Both target conditions observed. Scenario outcome arbitration determines the final result.",
        "seconds": 25,
        "effects": []
      }
    ]
  },
