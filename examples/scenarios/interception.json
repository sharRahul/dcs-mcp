        "text": "Scenario cue: bomber track northeast of Intercept Gate. This timed update is not a radar detection.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "escalate",
        "phase": "reinforcements",
        "channel": "control",
        "when": {
          "afterEvent": "depart",
          "delaySeconds": 90
