        "effects": [
          {
            "kind": "activate_group",
            "group": "Bandits"
          }
        ]
      },
      {
        "id": "success",
        "phase": "victory",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Bombers"
            }
          ]
        },
        "template": "success",
        "subject": "the bomber intercept; scenario outcome arbitration still applies"
      },
      {
        "id": "protected_lost",
        "phase": "failure",
        "channel": "control",
        "when": {
          "conditions": [
            {
              "kind": "flag_is_true",
              "flag": 50
            }
          ]
        },
        "text": "Defenders have been destroyed. The protected-force objective has failed.",
        "seconds": 25,
        "effects": []
      },
      {
        "id": "recovered",
        "phase": "atc_recovery",
        "channel": "control",
        "when": {
          "worldEvent": {
            "kind": "land",
            "unit": "Intercept-1"
          },
          "conditions": [
            {
              "kind": "group_dead",
              "group": "Bombers"
            }
          ]
        },
        "text": "Landing event recorded after bomber destruction. This cue does not verify the landing airfield or score a separate recovery objective.",
        "seconds": 25,
        "effects": []
      }
    ]
  },
  "assumptions": [
    "Fictional modern training scenario; country assignments are game settings, not historical service-date claims.",
