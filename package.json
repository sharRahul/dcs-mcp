{
  "name": "dcs-mcp-server",
  "version": "0.2.0",
  "mcpName": "io.github.sharRahul/dcs-mcp",
  "description": "Model Context Protocol server for DCS World: offline .miz mission authoring and inspection, plus a live-control bridge into a running sim",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dcs-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test --import tsx tests/*.test.ts",
    "build:e2e-mission": "node scripts/build-e2e-mission.mjs",
    "verify:miz": "node scripts/verify-mission.mjs",
    "monitor": "node scripts/monitor-flight.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "install-hook": "node dist/index.js install-hook"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dcs",
    "dcs-world",
    "mission-editor",
    "miz",
    "flight-simulator",
    "claude"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharRahul/dcs-mcp.git"
  },
  "homepage": "https://www.dcs-mcp.com",
  "bugs": {
    "url": "https://github.com/sharRahul/dcs-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "adm-zip": "^0.6.0",
    "luaparse": "^0.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/luaparse": "^0.2.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
