{
  "name": "dcs-mcp-server",
  "version": "0.6.4",
  "mcpName": "io.github.sharRahul/dcs-mcp",
  "description": "Model Context Protocol server for DCS World: offline .miz mission authoring and inspection, plus a live-control bridge into a running sim",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dcs-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "data",
    "scripts",
    "examples",
    "docs/testing/live-acceptance",
    "docs/technical-reference.md",
    "docs/claude-desktop.md",
    "docs/mission-audio.md",
    "docs/verification.md",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "plugin:build": "node scripts/build-chatgpt-plugin.mjs",
    "plugin:verify": "node scripts/verify-chatgpt-plugin.mjs",
    "bundle:build": "node scripts/build-claude-bundle.mjs",
    "bundle:validate": "mcpb validate plugins/dcs-claude-desktop/manifest.json",
    "bundle:verify": "node scripts/verify-claude-bundle.mjs",
    "build": "tsc",
    "check": "tsc --noEmit",
    "acceptance:generate": "node scripts/generate-acceptance.mjs",
    "acceptance:lua51": "node scripts/verify-acceptance-lua.mjs",
    "verify:design": "node scripts/verify-design.mjs",
    "verify:lua51": "node scripts/verify-lua51.mjs",
    "verify:capabilities": "node scripts/verify-capabilities.mjs",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node scripts/run-tests.mjs",
    "build:e2e-mission": "node scripts/build-e2e-mission.mjs",
    "verify:miz": "node scripts/verify-mission.mjs",
    "monitor": "node scripts/monitor-flight.mjs",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "install-hook": "node dist/index.js install-hook",
    "install-claude-desktop": "node dist/index.js install-claude-desktop",
    "acceptance:collect": "node scripts/collect-acceptance.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dcs",
    "dcs-world",
    "mission-editor",
    "miz",
    "flight-simulator",
    "claude"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharRahul/dcs-mcp.git"
  },
  "homepage": "https://github.com/sharRahul/dcs-mcp",
  "bugs": {
    "url": "https://github.com/sharRahul/dcs-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "adm-zip": "^0.6.1",
    "luaparse": "^0.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/adm-zip": "^0.5.7",
    "@types/luaparse": "^0.2.12",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
