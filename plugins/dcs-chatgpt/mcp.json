{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "dcs": {
      "type": "stdio",
      "command": "node",
      "args": ["${PLUGIN_ROOT}/server/dist/index.js"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "DCS_BRIDGE_HOST": "127.0.0.1",
        "DCS_BRIDGE_PORT": "8899"
      }
    }
  }
}
